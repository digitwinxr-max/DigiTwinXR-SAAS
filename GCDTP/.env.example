# DigiTwinXR-SAAS Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/gcdtp
TIMESCALEDB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@timescaledb:5432/gcdtp
POSTGRES_PASSWORD=your_secure_password_here

# Neo4j
NEO4J_AUTH=neo4j/${NEO4J_PASSWORD}
NEO4J_PASSWORD=your_secure_neo4j_password

# Redis
REDIS_PASSWORD=

# Kafka
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

# MQTT/EMQX
EMQX_ADMIN_PASSWORD=your_secure_emqx_password

# Security
SECRET_KEY=your_secure_secret_key_here_min_32_chars
JWT_SECRET_KEY=your_jwt_secret_key_here

# Frontend
VITE_API_URL=http://localhost:8080
