# DigiTwinXR-SAAS Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/gcdtp
TIMESCALEDB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@timescaledb:5432/gcdtp
POSTGRES_PASSWORD=your_secure_password_here

# Neo4j
NEO4J_AUTH=neo4j/${NEO4J_PASSWORD}
NEO4J_PASSWORD=your_secure_neo4j_password

# Redis
REDIS_PASSWORD=

# Kafka
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

# MQTT/EMQX
EMQX_ADMIN_PASSWORD=your_secure_emqx_password

# Security - JWT Configuration
# REQUIRED: Application will fail to start if these are missing or are placeholder values
JWT_SECRET_KEY=change_me
JWT_REFRESH_SECRET_KEY=change_me

# CORS Configuration
# Comma-separated list of allowed origins (no spaces around commas)
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8080
